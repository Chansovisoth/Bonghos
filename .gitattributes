* text=auto eol=lf

# Scripts and source copied to Linux must never acquire CRLF line endings.
*.sh text eol=lf
Makefile text eol=lf
*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf

# Web UI assets and packaged fixtures are binary.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.zip binary
*.otf binary
*.ttf binary
