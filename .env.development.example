# Local Web UI notification debugging
#
# Copy this file to .env.development and insert real credentials there.
# .env.development is ignored by Git. Never put real tokens in this example.

BONGHOS_DEV_TELEGRAM_TOKEN=
BONGHOS_DEV_TELEGRAM_NAME=Telegram development

BONGHOS_DEV_DISCORD_TOKEN=
BONGHOS_DEV_DISCORD_CHANNEL_ID=
BONGHOS_DEV_DISCORD_NAME=Discord development

# Optional. The development relay binds only to 127.0.0.1.
BONGHOS_DEV_PORT=8000
